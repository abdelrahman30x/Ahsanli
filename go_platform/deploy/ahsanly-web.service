[Unit]
Description=AHSANLY Next.js public site
After=network-online.target ahsanly-api.service
Wants=network-online.target

[Service]
Type=simple
User=botdeals
Group=botdeals
WorkingDirectory=/srv/ahsanly
EnvironmentFile=/etc/ahsanly/ahsanly.env
Environment=API_INTERNAL_URL=http://127.0.0.1:8083
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
ExecStart=/opt/ahsanly-node/bin/node /srv/ahsanly/web_next/server.js
Restart=on-failure
RestartSec=10
MemoryMax=210M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
