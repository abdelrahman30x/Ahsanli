map $request_method $botafflite_login_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $botafflite_login_key zone=botafflite_login_post:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=botafflite_catalog_api:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    server_name 134.122.89.95;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/botafflite-acme;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name 134.122.89.95;
    ssl_certificate /etc/letsencrypt/live/134.122.89.95/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/134.122.89.95/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /static/ {
        alias /var/www/botafflite-static/;
    }
    location = /api/v1/admin/session {
        limit_req zone=botafflite_login_post burst=5 nodelay;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
    }
    location ^~ /api/v1/ {
        limit_req zone=botafflite_catalog_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
    }
    location = /login/ {
        limit_req zone=botafflite_login_post burst=5 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /otp/ {
        limit_req zone=botafflite_login_post burst=5 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location ~ ^/(dashboard|admin|logout|listing|candidate|evidence)/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 20s;
    }
}
