[Unit]
Description=BotAfflite Go verified deal photo pipeline
After=network-online.target postgresql@18-main.service
Wants=network-online.target

[Service]
Type=simple
User=botdeals
Group=botdeals
WorkingDirectory=/root/botAfflite
EnvironmentFile=/root/botAfflite/deal.env
ExecStart=/root/botAfflite/go_platform/bin/botafflite-pipeline --apply --allow-live-channels --browser=/opt/botafflite-chromium/chrome-headless-shell --capture-dir=/root/botAfflite/deal_captures
Restart=on-failure
RestartSec=15
MemoryMax=500M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/botAfflite/deal_captures
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
