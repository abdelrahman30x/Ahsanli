# AHSANLY production environment template.
# Copy to /etc/ahsanly/ahsanly.env and fill secrets. Never commit the real file.

# Django/Go shared secret (used for password hashes and sessions)
DEAL_SECRET_KEY=change-me

# PostgreSQL
DEAL_DB_NAME=ahsanly
DEAL_DB_USER=ahsanly_app
DEAL_DB_PASSWORD=change-me
DEAL_DB_HOST=127.0.0.1
DEAL_DB_PORT=5432

# Publication gates (keep 0 until release gate passes)
DEAL_PUBLISH_ENABLED=0
DEAL_GO_PUBLISH_ENABLED=0

# Go admin console
DEAL_GO_ADMIN_ENABLED=1
DEAL_GO_ADMIN_ORIGIN=https://ahsanli.com

# Telegram bot token environment references.
# The actual tokens are configured in BotFather and stored only here.
DEAL_TELEGRAM_TOKEN_AHSANLY_BOT=change-me
DEAL_TELEGRAM_TOKEN_AHSANLY_TEST=change-me

# Hosts/CSRF
DEAL_ALLOWED_HOSTS=ahsanli.com,eg.ahsanli.com,www.ahsanli.com,127.0.0.1
DEAL_CSRF_ORIGINS=https://ahsanli.com,https://eg.ahsanli.com,https://www.ahsanli.com

# Listen address for Go API
DEAL_GO_LISTEN=127.0.0.1:8083

# Paths
AHSANLY_CAPTURE_DIR=/var/lib/ahsanly/captures
AHSANLY_GEOIP_DB=/etc/ahsanly/dbip-country-lite.mmdb
